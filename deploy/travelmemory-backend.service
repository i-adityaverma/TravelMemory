[Unit]
Description=Travel Memory backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/TravelMemory/backend
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.4/bin/node /home/ubuntu/TravelMemory/backend/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
